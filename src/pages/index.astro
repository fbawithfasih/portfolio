---
import Base from '../layouts/Base.astro';

const email = 'fasihuddin@live.com';
const linkedin = 'https://www.linkedin.com/in/fasih-ahmer';
const github = 'https://github.com/fbawithfasih';
const repo = 'https://github.com/fbawithfasih/portfolio';
---

<Base
  title="Fasihuddin Ahmer, e-commerce manager for Amazon and Shopify"
  description="E-commerce manager with 7+ years across Amazon marketplaces (US, CA, MX, AU) and Shopify D2C operations, plus performance marketing, analytics and automation."
>
  <div class="page">
    <aside class="rail">
      <p class="name">Fasihuddin Ahmer</p>
      <p class="role">E-commerce manager for Amazon and Shopify, digital operations</p>

      <nav aria-label="Sections">
        <ul>
          <li><a href="#work">Work</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#expertise">Expertise</a></li>
          <li><a href="#credentials">Credentials</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>

      <ul class="contact">
        <li><a href={`mailto:${email}`}>Email</a></li>
        <li><a href={linkedin} rel="me noopener">LinkedIn</a></li>
        <li><a href={github} rel="me noopener">GitHub</a></li>
        <li><a href="/Fasihuddin-Ahmer-Resume.pdf">Resume (PDF)</a></li>
      </ul>

      <p class="avail">Based in Agra, India. Open to relocation and remote work.</p>
    </aside>

    <main id="main">
      <header class="hero">
        <h1>I run e-commerce across Amazon and Shopify, and build the tools that keep it moving.</h1>

        <p class="lede">
          I close <span class="mark" style="--i:0">80% of critical ASIN escalations within 24 hours</span>. Across 14
          client accounts, my agency held <span class="mark" style="--i:1">90%+ satisfaction</span> and an
          <span class="mark" style="--i:2">80% renewal rate</span>.
        </p>
        <p>
          I have 7+ years running e-commerce across Amazon US, Canada, Mexico and Australia, and live Shopify stores
          with their own catalog, payment gateways and checkout. I'm looking for e-commerce, marketplace and digital
          operations roles.
        </p>

        <div class="actions">
          <a class="button primary" href="/Fasihuddin-Ahmer-Resume.pdf">Download resume</a>
          <a class="button" href={`mailto:${email}`}>Email me</a>
        </div>
      </header>

      <section class="about" aria-label="About">
        <p>
          <strong>I run marketplaces and my own stores.</strong> On Amazon I work across Vendor Central and Seller
          Central for large SKU portfolios: pricing, inventory, catalog and promotions. On Shopify I run stores end to
          end, from catalog and content to CCAvenue, Razorpay, PayPal and PayU checkout, COD processes and
          cancellation and RTO control.
        </p>
        <p>
          <strong>I pair performance marketing with analytics.</strong> I hold seven Amazon Advertising
          certifications and optimize ACOS, TACOS and ROAS across Sponsored Ads and DSP. For clients I kept ACOS
          under <span class="mark">20%</span> at <span class="mark">4.5+ ROAS</span> on $8K+ monthly budgets. SQL,
          Excel and SKU-level profitability dashboards turn that into weekly decisions.
        </p>
        <p>
          <strong>I build the tools I need.</strong> Reporting and automation on Amazon SP-API and Ads API, sites
          and SaaS products, and AMAIOP, a platform for Amazon seller analytics and ad optimization. I build them
          with Claude Code.
        </p>
      </section>

      <section id="work" aria-labelledby="work-h">
        <h2 id="work-h">Work</h2>

        <article class="entry">
          <div class="when">Jan 2025 to present</div>
          <div>
            <h3>E-commerce sales manager</h3>
            <p class="where">Sound Around and Pyle USA, remote from India for a US company</p>
            <p>
              I manage a large Amazon SKU portfolio across vendor and seller channels for the SereneLife, NutriChef,
              SQUATZ and Pyle brands. I own pricing, inventory, catalog and promotion decisions through a liquidation
              and wind-down program, protecting margin while clearing stock.
            </p>
            <p>
              I build SKU-level performance reports and dashboards that guide weekly commercial decisions, and I
              resolve critical ASIN escalations with Amazon Vendor Support, Sales and Operations, closing
              <span class="mark">80% within a 24-hour SLA</span>.
            </p>
          </div>
        </article>

        <article class="entry">
          <div class="when">Jun 2019 to present, part-time since Jan 2025</div>
          <div>
            <h3>Co-founder</h3>
            <p class="where">Hive Mind Nestor, AI development agency and Amazon-focused SaaS company, Agra</p>
            <p>
              We are an Amazon SPN and Ads Verified Partner and a member of the Anthropic Claude Partner Network. I
              delivered account, advertising and listing management for 14 clients across the US, CA, MX and AU
              marketplaces, with <span class="mark">90%+ satisfaction</span>, an
              <span class="mark">80% renewal rate</span>, a 24-month average tenure and a
              <span class="mark">40% increase</span> in recurring sales.
            </p>
            <p>
              I built Queenza Crafts' Amazon business from business plan to launch, PPC, logistics and trademark
              registration, reaching <span class="mark">$200K+ a year</span> in revenue at a 30% net margin. I also
              built websites, SaaS products and agency management tools on SP-API and Ads API with Claude Code, and
              led a team of 10 account executives and PPC specialists.
            </p>
          </div>
        </article>

        <article class="entry">
          <div class="when">2003 to 2019</div>
          <div>
            <h3>Earlier in sales and operations</h3>
            <p class="where">Education, training and IT channel businesses, India</p>
            <p>
              I co-founded Arisetotal Innovative Education, opened 4 franchise centres in 3 months and grew enrollment
              40% year on year. Before that I founded a corporate training business and ran branches at Frankfinn,
              HCL Infosystems (20 direct reports, Best Branch Manager 2012) and ICFAI Group (8 direct reports), after
              sales roles at Sahara Computers and Samsung Electronics.
            </p>
          </div>
        </article>
      </section>

      <section id="projects" aria-labelledby="projects-h">
        <h2 id="projects-h">Projects</h2>
        <ul class="projects">
          <li>
            <h3><a href="https://thesangemarmar.com">thesangemarmar.com</a></h3>
            <p>
              A luxury marble inlay brand's Shopify store, which I run end to end: catalog, content, payment gateways
              (CCAvenue, Razorpay, PayPal, PayU), checkout and marketing.
            </p>
            <p class="meta">Shopify. Live store.</p>
          </li>
          <li>
            <h3><a href="https://iwisglobal.com">iwisglobal.com</a></h3>
            <p>A website I built end to end with Claude Code, with payment gateways enabled.</p>
            <p class="meta">Astro, Claude Code. Live site.</p>
          </li>
          <li>
            <h3><a href="https://www.hivemindnestor.com/">hivemindnestor.com</a></h3>
            <p>The Hive Mind Nestor agency website, designed and developed end to end.</p>
            <p class="meta">Astro, Claude Code. Live site.</p>
          </li>
          <li>
            <h3>Queenza on Amazon US</h3>
            <p>A furniture and homeware brand I managed on Amazon US.</p>
            <p class="meta">Amazon, PPC, logistics, trademark.</p>
          </li>
          <li>
            <h3>AMAIOP</h3>
            <p>
              A SaaS platform for Amazon seller analytics and advertising optimization, built on SP-API and Ads API
              with Claude Code.
            </p>
            <p class="meta">Amazon SP-API, Ads API, Keepa, Claude. Runs on Railway and Cloudflare.</p>
          </li>
          <li>
            <h3>eseller360</h3>
            <p>An Etsy seller SaaS that syncs listings and orders, reports analytics and handles webhooks.</p>
            <p class="meta">TypeScript. Private repository.</p>
          </li>
          <li>
            <h3><a href="https://github.com/fbawithfasih/Sangemarmar-VTS">Sangemarmar VTS</a></h3>
            <p>
              A vehicle entry, sales and commission management system for The Sangemarmar, with a NestJS and
              PostgreSQL backend and a Flutter mobile app.
            </p>
            <p class="meta">NestJS, PostgreSQL, Flutter, Docker. Public repository.</p>
          </li>
          <li>
            <h3><a href="https://github.com/fbawithfasih/hive-mind-ad-optimizer">hive-mind-ad-optimizer</a></h3>
            <p>An advertising optimization tool from the Hive Mind Nestor toolkit.</p>
            <p class="meta">JavaScript. Public repository.</p>
          </li>
        </ul>
      </section>

      <section id="expertise" aria-labelledby="expertise-h">
        <h2 id="expertise-h">Expertise</h2>
        <dl class="facts">
          <div>
            <dt>E-commerce operations</dt>
            <dd>Shopify store management, catalog and content, pricing, inventory planning, order fulfillment, cancellation and RTO control.</dd>
          </div>
          <div>
            <dt>Payments and checkout</dt>
            <dd>CCAvenue, Razorpay, PayPal and PayU integration, COD processes, checkout UX and conversion.</dd>
          </div>
          <div>
            <dt>Marketplaces</dt>
            <dd>Amazon Vendor Central and Seller Central, Amazon.in and global marketplaces, Walmart, eBay, Etsy, Target.</dd>
          </div>
          <div>
            <dt>Performance marketing</dt>
            <dd>Sponsored Products, Brands and Display, Amazon DSP, Amazon Marketing Cloud, ACOS, TACOS and ROAS, A/B testing.</dd>
          </div>
          <div>
            <dt>Analytics</dt>
            <dd>SQL, advanced Excel with pivots and macros, KPI dashboards, SKU-level profitability reporting, BI.</dd>
          </div>
          <div>
            <dt>Automation and AI</dt>
            <dd>Claude Code, Amazon SP-API and Ads API tools, workflow automation.</dd>
          </div>
          <div>
            <dt>Management</dt>
            <dd>Vendor and account management, contract negotiation, escalation handling, SOPs and playbooks, cross-functional coordination.</dd>
          </div>
          <div>
            <dt>Tools</dt>
            <dd>Perpetua, Helium10, SellerSprite, Keepa, Goflow.</dd>
          </div>
        </dl>
      </section>

      <section id="credentials" aria-labelledby="credentials-h">
        <h2 id="credentials-h">Credentials</h2>
        <dl class="facts">
          <div>
            <dt>Education</dt>
            <dd>
              Post Graduate Program in Data Analytics, Purdue University Online (in progress). MBA in Sales and
              Marketing, EIILM University. Advanced Certificate in Digital Marketing and Communication, MICA. BSc in
              Mathematics, Statistics and Economics, Dr. B.R. Ambedkar University.
            </dd>
          </div>
          <div>
            <dt>Amazon Ads</dt>
            <dd>Seven certifications, including Amazon Marketing Cloud Foundations, Amazon DSP, Sponsored Ads Advanced and Ads for Retail Advanced.</dd>
          </div>
          <div>
            <dt>Other</dt>
            <dd>SQL for Data Analytics and Business Analytics with Excel (Simplilearn), Freedom Ticket 3.0 (Helium10), Generative AI Mastermind (GrowthSchool).</dd>
          </div>
          <div>
            <dt>Languages</dt>
            <dd>English (professional), Hindi (native), Arabic (beginner).</dd>
          </div>
        </dl>
      </section>

      <section id="contact" aria-labelledby="contact-h" class="contact-block">
        <h2 id="contact-h">Contact</h2>
        <p>The fastest way to reach me is email.</p>
        <p><a href={`mailto:${email}`}>{email}</a></p>
        <p>
          <a href={linkedin} rel="me noopener">LinkedIn</a>, <a href={github} rel="me noopener">GitHub</a> and my
          agency site, <a href="https://www.hivemindnestor.com/">Hive Mind Nestor</a>.
        </p>
        <div class="actions">
          <a class="button primary" href="/Fasihuddin-Ahmer-Resume.pdf">Download resume</a>
        </div>
      </section>

      <footer>
        <p>Built with Astro and hosted on Cloudflare.</p>
        <p><a href={repo}>Source on GitHub</a></p>
      </footer>
    </main>
  </div>
</Base>
